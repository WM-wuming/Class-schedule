<?xml version="1.0" encoding="utf-8"?>
<!-- 「下一节课」小组件的紧凑尺寸（2 格宽 × 1 格高）：放不下四行大卡片，
     只留两行 —— 课程名 + 时间/地点；状态与日期（上课中/明天…）拼进第二行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/next_class_widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="7dp">

    <!-- 有课时的正文：垂直居中的两行 -->
    <LinearLayout
        android:id="@+id/widget_small_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_small_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="高数"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_small_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="10:15-11:50 · 教学楼A-101"
            android:textColor="#7FB3FF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 没课时的空状态 -->
    <TextView
        android:id="@+id/widget_small_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="没有课了"
        android:textColor="#DCE4F0"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
