# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 构建产物副本（安装包，体积大且可重建）
/dist/

# Android 本地路径配置（含本机 SDK/flutter 路径，机器相关）
/android/local.properties
/android/.gradle/

# Gradle 在 android/ 下生成的构建报告
/android/build/

# Android 发布签名：密钥库与密码，绝不入库（丢了就无法再更新已发布的包）
/android/key.properties
/android/*.jks
/android/*.keystore

# 抓取接口时的临时调试产物
/.jw_probe/

# WorkBuddy 代理的工作数据（记忆日志、构建临时日志），不属于应用源码
/.workbuddy/
